{
  "name": "remxr42 DJ Workstation",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "forwardPorts": [8542],
  "portsAttributes": {
    "8542": {
      "label": "remxr42 Console",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libsndfile1 ffmpeg && pip install -e .",
  "postStartCommand": "remxr42 --port 8542",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
